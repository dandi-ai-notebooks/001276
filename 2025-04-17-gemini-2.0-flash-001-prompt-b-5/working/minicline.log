import pynwb
import h5py
import remfile
import matplotlib.pyplot as plt
import numpy as np

# Load
url = "https://api.dandiarchive.org/api/assets/95141d7a-82aa-4552-940a-1438a430a0d7/download/"
remote_file = remfile.File(url)
h5_file = h5py.File(remote_file)
io = pynwb.NWBHDF5IO(file=h5_file)
nwb = io.read()

# Get image data
image_data = nwb.acquisition['SingleTimePointImaging'].data

# Extract a subset of the data
subset_size = 100
subset_data = image_data[0, 0:subset_size, 0:subset_size]

# Plot the subset
plt.imshow(subset_data, cmap='gray')
plt.title('Subset of Image Data')
plt.colorbar()
plt.savefig("explore/image_subset.png")
plt.close()
